{
  "name": "@translifyhq/client",
  "version": "0.1.0",
  "description": "Runtime client for Translify delivery: fetch, cache and revalidate published translations",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chesterbrains/translify-js.git"
  },
  "homepage": "https://github.com/chesterbrains/translify-js#readme",
  "bugs": {
    "url": "https://github.com/chesterbrains/translify-js/issues"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "translify-client": "./dist/cli/bin.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup",
    "prepublishOnly": "pnpm build",
    "test": "vitest run",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@types/node": "^20.19.43",
    "esbuild": "^0.25.0",
    "eslint": "^10.11.0",
    "tsup": "^8.5.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^4.1.11"
  },
  "publishConfig": {
    "access": "public"
  },
  "packageManager": "pnpm@10.34.6"
}
